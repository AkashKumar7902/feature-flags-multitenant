generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ORG_ADMIN
  END_USER
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  users       User[]

  @@map("roles")
}

model Organization {
  id                         String        @id @default(uuid()) @db.Uuid
  name                       String        @db.VarChar(120)
  slug                       String        @unique @db.VarChar(64)
  adminInviteCodeHash        String?       @map("admin_invite_code_hash") @db.VarChar(128)
  adminInviteCodeExpiresAt   DateTime?     @map("admin_invite_code_expires_at")
  createdAt                  DateTime      @default(now()) @map("created_at")
  updatedAt                  DateTime      @updatedAt @map("updated_at")
  users                      User[]
  featureFlags               FeatureFlag[]

  @@index([slug])
  @@map("organizations")
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  email          String           @unique @db.Citext
  passwordHash   String           @map("password_hash") @db.VarChar(255)
  name           String           @db.VarChar(120)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  lastLoginAt    DateTime?        @map("last_login_at")
  deletedAt      DateTime?        @map("deleted_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshSessions RefreshSession[]

  @@index([organizationId])
  @@index([roleId])
  @@map("users")
}

model FeatureFlag {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  key            String       @db.VarChar(80)
  description    String?      @db.VarChar(500)
  enabled        Boolean      @default(false)
  createdById    String?      @map("created_by_id") @db.Uuid
  updatedById    String?      @map("updated_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId, enabled])
  @@map("feature_flags")
}

model RefreshSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(128)
  userAgent   String?   @map("user_agent") @db.VarChar(255)
  ipAddress   String?   @map("ip_address") @db.VarChar(80)
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorRole      String   @map("actor_role") @db.VarChar(40)
  actorEmail     String?  @map("actor_email") @db.Citext
  organizationId String?  @map("organization_id") @db.Uuid
  action         String   @db.VarChar(120)
  targetType     String   @map("target_type") @db.VarChar(80)
  targetId       String?  @map("target_id") @db.VarChar(120)
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}
